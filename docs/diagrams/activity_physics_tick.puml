@startuml activity_physics_tick

skinparam defaultFontSize 11
skinparam shadowing false
skinparam ActivityFontSize 12

title Physics Engine — Single Tick Decision (DT = 1 second)

start

:Read current state;
note right
  speed_ms, posOnSegment_m
  segmentLength_m, speedLimit_ms
  accelRate, decelRate
end note

:Pick target end speed;
note right
  final segment: 0
  otherwise: next segment's speed limit
  (no needless stop at intermediate nodes)
end note

:Compute braking distance;
note right
  brakeDist = (v² − targetEnd²) / (2 × decelRate)
  plus a small tolerance
end note

:Compute distance to segment end;
note right
  distToEnd = segmentLength - posOnSegment
end note

if (distToEnd <= brakeDist?) then (yes — must brake)
  :Apply deceleration;
  note right
    speed -= decelRate × DT
    floored at targetEnd
  end note
  :action = "Braking";
elseif (speed < speedLimit?) then (yes — can accelerate)
  :Apply acceleration;
  note right
    speed += accelRate × DT
    if speed > speedLimit → speed = speedLimit
  end note
  :action = "Speed up";
else (at speed limit)
  :Maintain speed;
  :action = "Maintain";
endif

:Update position;
note right
  posOnSegment += (oldSpeed + newSpeed)/2 × DT
  (trapezoidal)
end note

if (posOnSegment >= segmentLength?) then (yes)
  :Handle segment transition;
  note right
    • Advance to next node
    • Check events at node
    • If intermediate → start stopTimer
    • If final → mark arrived
  end note
else (no)
  :Continue on segment;
endif

if (every 60 seconds?) then (yes)
  :Notify observer;
  note right
    onTrainStep(time, from, to,
    distRemaining, action, railGraph)
  end note
else (no)
endif

#LightYellow:Invoke animation callback\n(if registered);
note right
  **Bonus — Animation / GUI**
  _animCallback(simTime, states)
  • --animate → TerminalAnimDisplay::render()
  • GUI → signal tick(simTime, snapshots)
  Called once per tick after all trains
  are processed. The GUI worker emits a
  frame every 30 sim-s / speedMultiplier
  and sleeps 50 ms after each emitted frame.
end note

#LightCyan:GUI worker callback checks stop flag;
note right
  if _stopRequested.load()
    throw SimulationStopException
  (owned by SimulationWorker, not Simulation)
end note

stop

@enduml
